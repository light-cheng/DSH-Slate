{
  "name": "dsh-slate",
  "version": "0.1.0",
  "private": true,
  "description": "DSH-Slate: workspace-isolated, evidence-backed project view in the DeepSeek Harness right sidebar.",
  "type": "module",
  "icon": "./icon.png",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./icon": "./icon.png",
    "./package.json": "./package.json"
  },
  "files": [
