{
  "name": "dsh-slate",
  "version": "0.1.0",
  "private": false,
  "description": "DSH-Slate: workspace-isolated, evidence-backed project progress tracker in the DeepSeek Harness right sidebar.",
  "type": "module",
  "icon": "./icon.png",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./icon": "./icon.png",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "icon.png",
    "assets/",
    "src/",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "RELEASE.md",
    "MARKETPLACE.md",
    "LICENSE",
    "screenshots.json"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "verify": "node scripts/verify.mjs",
    "check": "node scripts/verify.mjs",
    "test": "node scripts/verify.mjs",
    "prepack": "node scripts/build.mjs"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "project-progress",
    "sidebar",
    "workspace",
    "slate"
  ],
  "engines": {
    "node": ">=22.0.0",
    "dsh": ">=0.2.1-rc.5 <0.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "author": "Light Cheng (https://github.com/light-cheng)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/light-cheng/DSH-Slate.git",
    "directory": "plugin"
  },
  "homepage": "https://github.com/light-cheng/DSH-Slate#readme",
  "bugs": {
    "url": "https://github.com/light-cheng/DSH-Slate/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
